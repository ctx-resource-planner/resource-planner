# tests/test_login.py
from playwright.sync_api import Page, expect
import time

def test_login_page_loads(page: Page, base_url):
    """Test that the login page loads correctly."""
    page.goto(f"{base_url}/login")
    # Updated to match actual page title
    expect(page).to_have_title("Login - Resource Planner")
    # Verify form elements exist
    expect(page.locator('input[name="username"]')).to_be_visible()
    # Updated password field name to match your form
    expect(page.locator('input[type="password"]')).to_be_visible()
    expect(page.locator('button[type="submit"]')).to_be_visible()

def test_successful_login(page: Page, base_url):
    """Test that a user can log in with valid credentials."""
    # Navigate to the login page
    page.goto(f"{base_url}/login")
    
    # Print the page content for debugging
    print("Page content:", page.content())
    
    # Fill in the login form
    username = page.locator('input[name="username"]')
    password = page.locator('input[type="password"]')
    submit = page.locator('button[type="submit"]')
    
    # Debug: Print if elements are found
    print(f"Found username field: {username.count() > 0}")
    print(f"Found password field: {password.count() > 0}")
    print(f"Found submit button: {submit.count() > 0}")
    
    # Fill the form
    username.fill('admin')  # Update with your test username
    password.fill('admin')  # Update with your test password
    
    # Submit the form
    submit.click()
    
    # Wait for navigation with a timeout
    try:
        # Wait for either redirection or error message
        page.wait_for_url("**/", timeout=5000)
    except:
        # If no redirection, check for error message
        error = page.locator('.alert.alert-danger').text_content()
        print(f"Login failed with error: {error}")
        raise

    # Verify we're on the dashboard/home page
    expect(page).to_have_url(f"{base_url}/")
    # Check for some element that indicates successful login
    expect(page.locator('body')).to_contain_text('Dashboard')  # Update with actual text

def test_failed_login(page: Page, base_url):
    """Test that login fails with invalid credentials."""
    page.goto(f"{base_url}/login")
    
    # Fill in with invalid credentials
    page.fill('input[name="username"]', 'wronguser')
    page.fill('input[type="password"]', 'wrongpass')
    page.click('button[type="submit"]')
    
    # Wait for error message
    error_message = page.locator('.alert.alert-danger')
    error_message.wait_for(state='visible', timeout=5000)
    
    # Verify error message is displayed
    expect(error_message).to_contain_text('Invalid username or password')  # Update with actual error text
