from playwright.sync_api import Page, expect
import time

def test_login_page_loads(page: Page, base_url):
    """Test that the login page loads correctly."""
    page.goto(f"{base_url}/login")
    expect(page).to_have_title("Login")  # Update with your login page title
    expect(page.locator('input[name="username"]')).to_be_visible()
    expect(page.locator('input[name="password"]')).to_be_visible()
    expect(page.locator('button[type="submit"]')).to_be_visible()

def test_successful_login(page: Page, base_url):
    """Test that a user can log in with valid credentials."""
    # Navigate to the login page
    page.goto(f"{base_url}/login")
    
    # Fill in the login form
    page.fill('input[name="username"]', 'admin')  # Update with your test username
    page.fill('input[name="password"]', 'admin')  # Update with your test password
    
    # Submit the form
    page.click('button[type="submit"]')
    
    # Wait for navigation to complete
    page.wait_for_load_state('networkidle')
    
    # Verify redirection after successful login
    expect(page).to_have_url(f"{base_url}/")  # Should redirect to home page
    
    # Verify user is logged in (update with actual element/text from your app)
    expect(page.locator('body')).to_contain_text('Dashboard')  # Update with actual text

def test_failed_login(page: Page, base_url):
    """Test that login fails with invalid credentials."""
    page.goto(f"{base_url}/login")
    
    # Fill in with invalid credentials
    page.fill('input[name="username"]', 'wronguser')
    page.fill('input[name="password"]', 'wrongpass')
    page.click('button[type="submit"]')
    
    # Wait for any error message to appear
    page.wait_for_selector('.alert-danger, .error', state='visible', timeout=5000)
    
    # Verify error message is displayed
    expect(page.locator('body')).to_contain_text('Invalid username or password')  # Update with actual error message
