{% extends 'base.html' %}
{% block title %}Projects Management{% endblock %}
{% block content %}
<div class="card shadow-sm">
    <div class="card-header d-flex justify-content-between align-items-center">
        <div class="d-flex align-items-center">
            <span class="me-3"><i class="fas fa-tasks me-2"></i>Projects List</span>
            <div class="input-group input-group-sm" style="width: 450px;">
                <span class="input-group-text"><i class="fas fa-search"></i></span>
                <input type="text" id="searchInput" class="form-control" placeholder="Search projects...">
                <span class="input-group-text bg-transparent border-0 small text-muted">
                    <i class="fas fa-info-circle me-1"></i>All allocation values are in FTE
                </span>
            </div>
        </div>
        {% if current_user.is_admin %}
            <a href="{{ url_for('add_project') }}" class="btn btn-success btn-sm">
                <i class="fas fa-plus me-1"></i> Add New Project
            </a>
        {% endif %}
    </div>
    <div class="card-body p-0">
        {% if projects %}
        <div class="table-responsive">
            <table class="table table-bordered table-hover table-condensed mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="wrap-text" style="min-width: 200px;">Name</th>
                        <th>Status</th>
                        <th>Service Line</th>
                        <th>Project Type</th>
                        <th class="no-wrap">SOW Start</th>
                        <th class="no-wrap">SOW End</th>
                        <th class="no-wrap">Actual Start</th>
                        <th class="no-wrap">Actual End</th>
                        <th>PO Amount</th>
                        <th>SOW Allocation</th>
                        <th>Actual Allocation</th>
                        {% if current_user.is_admin %}
                            <th style="width: 120px;">Actions</th>
                        {% endif %}
                    </tr>
                </thead>
                <tbody id="projectsTableBody" class="table-group-divider">
                    {% for project in projects %}
                    <tr>
                        <td class="align-middle" style="min-width: 200px;">{{ project.name }}</td>
                        <td class="align-middle">
                            <span class="badge {{ 'bg-success' if project.status == 'Active' else 'bg-secondary' }} text-white">
                                {{ project.status or 'Active' }}
                            </span>
                        </td>
                        <td class="align-middle">{{ project.service_line or 'N/A' }}</td>
                        <td class="align-middle">{{ project.project_type or 'N/A' }}</td>
                        <td class="no-wrap align-middle">{{ project.sow_start_date.strftime('%Y-%m-%d') if project.sow_start_date else 'N/A' }}</td>
                        <td class="no-wrap align-middle">{{ project.sow_end_date.strftime('%Y-%m-%d') if project.sow_end_date else 'N/A' }}</td>
                        <td class="no-wrap align-middle">{{ project.actual_start_date.strftime('%Y-%m-%d') if project.actual_start_date else 'N/A' }}</td>
                        <td class="no-wrap align-middle">{{ project.actual_end_date.strftime('%Y-%m-%d') if project.actual_end_date else 'N/A' }}</td>
                        <td class="align-middle">{{ "${:,.2f}".format(project.po_amount) if project.po_amount else 'N/A' }}</td>
                        <td class="align-middle">{{ project.sow_allocation_fte|round(2) if project.sow_allocation_fte is not none else 'N/A' }}</td>
                        <td class="align-middle">{{ project.actual_allocation_fte|round(2) if project.actual_allocation_fte is not none else 'N/A' }}</td>
                        {% if current_user.is_admin %}
                        <td class="actions align-middle">
                            <a href="{{ url_for('edit_project', project_id=project.id) }}"
                               class="btn btn-sm btn-outline-primary"
                               title="Edit Project">
                                <i class="fas fa-edit"></i>
                            </a>
                            <button onclick="toggleProjectStatus({{ project.id }})"
                                    class="btn btn-sm {{ 'btn-outline-warning' if project.status == 'Active' else 'btn-outline-success' }}"
                                    title="{{ 'Close' if project.status == 'Active' else 'Reopen' }} Project">
                                <i class="fas {{ 'fa-door-closed' if project.status == 'Active' else 'fa-door-open' }}"></i>
                            </button>
                        </td>
                        {% endif %}
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
        {% else %}
        <div class="alert alert-info m-3">No projects found.</div>
        {% endif %}
    </div>
</div>

<script>
function toggleProjectStatus(projectId) {
    const action = confirm('Are you sure you want to change this project status?');
    if (action) {
        fetch(`/toggle_project_status/` + projectId, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
            }
        })
        .then(response => {
            if (response.ok) {
                location.reload();
            }
        });
    }
}

// Add search functionality
document.addEventListener('DOMContentLoaded', function() {
    const searchInput = document.getElementById('searchInput');
    if (searchInput) {
        searchInput.addEventListener('keyup', function() {
            const searchTerm = this.value.toLowerCase();
            const rows = document.querySelectorAll('#projectsTableBody tr');

            rows.forEach(row => {
                const text = row.textContent.toLowerCase();
                row.style.display = text.includes(searchTerm) ? '' : 'none';
            });
        });
    }
});
</script>

<style>
/* Add some custom styles */
.badge {
    font-weight: 500;
    padding: 0.4em 0.75em;
    font-size: 0.8em;
}
.actions .btn {
    padding: 0.25rem 0.5rem;
    margin: 0 2px;
    min-width: 32px;
}
.table > :not(caption) > * > * {
    padding: 0.5rem 0.5rem;
}
.table > thead > tr > th {
    border-bottom-width: 1px;
    padding: 0.75rem 0.5rem;
}
.table > :not(:first-child) {
    border-top: 2px solid #dee2e6;
}
</style>
{% endblock %}
