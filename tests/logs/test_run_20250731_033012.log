                    page.click('button:has-text("Send"), button[type="submit"]')
                
                # Wait for success message
                success_message = page.locator('.alert.alert-success, .success-message')
                expect(success_message).to_contain_text('sent', timeout=10000)
                print("\n✓ Report email sent successfully")
                break
        
        if not email_clicked:
