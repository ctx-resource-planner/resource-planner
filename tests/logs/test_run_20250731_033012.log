@app.route('/skills/add', methods=['GET', 'POST'])
@admin_required
def add_skill():
    if request.method == 'POST':
        name = request.form.get('name', '').strip()
        if name:
            existing_skill = Skill.query.filter(func.lower(Skill.name) == func.lower(name)).first()
