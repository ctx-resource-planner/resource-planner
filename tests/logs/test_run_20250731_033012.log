# tests/conftest.py
import pytest
from playwright.sync_api import Playwright, sync_playwright
from app import create_app, db
import os

@pytest.fixture(scope='session')
def app():
    """Create and configure a new app instance for testing."""
    # Use test configuration
    os.environ['FLASK_ENV'] = 'testing'
    app = create_app()
    
    # Create test database
    with app.app_context():
        db.create_all()
        
    yield app
    
    # Clean up after tests
    with app.app_context():
        db.drop_all()

@pytest.fixture(scope='session')
def base_url():
    """Return the base URL for the test server."""
    return "http://localhost:5000"  # Update if your app runs on a different port

@pytest.fixture(scope='function')
def page(playwright: Playwright, base_url):
    """Create a new browser page for each test."""
    browser = playwright.chromium.launch(headless=True)  # Set to False to see the browser
    context = browser.new_context()
    page = context.new_page()
    
    yield page
    
    # Clean up
    context.close()
    browser.close()

@pytest.fixture(scope='session')
def playwright():
    with sync_playwright() as p:
        yield p
