            report_type.select_option(index=1)
            print(f"\nSelected report type: {options[1].inner_text()}")
        else:
            print("\nNo report options available")
            raise Exception("No report options available")
        
        # Set date range
        today = time.strftime("%Y-%m-%d")
        date_selectors = [
            'input[name="start_date"]',
            'input[type="date"]:nth-child(1)'
        ]
        
        start_date = None
        for selector in date_selectors:
            if page.locator(selector).count() > 0:
                start_date = page.locator(selector).first
                start_date.fill(today)
                print(f"Set start date to {today} using selector: {selector}")
                break
        
        # Look for download button
        download_buttons = [
            'button:has-text("Download Excel")',
            'button:has-text("Export")',
            'a:has-text("Download")',
            'button.download-btn',
            'button:has-text("Generate Report")'
        ]
        
        download_clicked = False
        for button_selector in download_buttons:
            if page.locator(button_selector).count() > 0:
                with page.expect_download() as download_info:
                    page.click(button_selector)
                    print(f"Clicked download button: {button_selector}")
                download = download_info.value
                assert download.suggested_filename.endswith(('.xlsx', '.xls')), "Expected Excel file"
                print(f"\n✓ Excel report downloaded: {download.suggested_filename}")
                download_clicked = True
                break
        
        if not download_clicked:
            print("\nCould not find download button. Available buttons:")
            print(page.locator('button, a.button, input[type="submit"]').all_inner_texts())
            raise Exception("Download button not found")
            
    except Exception as e:
        print(f"\n✗ Excel report download failed: {str(e)}")
        debug_page_content(page)
        raise

